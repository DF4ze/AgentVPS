<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>fr.ses10doigts</groupId>
    <artifactId>agentvps</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>AgentVPS</name>
    <description>Pilotage a distance de Claude Code (CLI) via Telegram, avec gestion de projets et de sessions persistantes</description>

    <properties>
        <java.version>21</java.version>
        <!-- Sans ces deux proprietes, le compilateur (et le rapport de build) retombent
             sur l'encodage "plateforme" par defaut du shell qui lance mvnw. Sur Windows,
             selon la console/le codepage actif, ca peut ne PAS etre UTF-8 malgre JDK 26 +
             JEP 400 - constate le 28/08/2026 : les caracteres accentues des sources UTF-8
             (ex. "archive" -> "archivé") se retrouvaient corrompus (caractere de
             remplacement U+FFFD) dans les String compilees, de facon non deterministe
             (ca marchait plus tot la meme journee). Fixe l'encodage independamment du
             shell/de la session utilisee pour lancer le build. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Module Telegram maison (fr.ses10doigts:telegram-bots-mvc) :
             apporte le long-polling Telegram (telegrambots-longpolling,
             telegrambots-client en transitif), le routing par annotations
             (@TelegramController/@Command/@Chat/@CallbackQuery), la whitelist
             de securite et l'envoi de messages (TelegramSender).
             A installer d'abord en local (mvn install depuis le projet
             TelegramBots) avant que cette dependance ne se resolve. -->
        <dependency>
            <groupId>fr.ses10doigts</groupId>
            <artifactId>telegram-bots-mvc</artifactId>
            <version>1.9.1</version>
        </dependency>

        <!-- Parsing du JSON renvoye par claude en mode print (sortie JSON)
             et (de)serialisation de la table projet vers session_id. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- java.time (Instant...) dans les DTO persistes (Project/Conversation/ProjectStore) :
             sans le starter Jackson de Spring (pas de spring-web ici, voir JacksonConfig),
             l'ObjectMapper explicite doit enregistrer ce module lui-meme. -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- ConfigurationProperties -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok (coherent avec le module TelegramBots) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>agentvps</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Resout le chemin du jar mockito-core en propriete Maven
                 (${groupId:artifactId:type}), utilisee ci-dessous pour
                 attacher Mockito en javaagent explicite au lieu du
                 self-attach dynamique (supprime les warnings Mockito +
                 "Dynamic loading of agents" + le warning JVM sharing qui
                 en decoule sur JDK 21+). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-mockito-agent</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:"${org.mockito:mockito-core:jar}"</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
